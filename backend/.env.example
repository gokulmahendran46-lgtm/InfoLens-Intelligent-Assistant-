# Application
APP_NAME=InfoLens
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/infolens
# For SQLite (development): DATABASE_URL=sqlite+aiosqlite:///./infolens.db

# AI Services (set one or both)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# AI Model selection
AI_PROVIDER=mock  # Options: openai, anthropic, mock
AI_MODEL=gpt-4o

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
